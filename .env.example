# Optional server credential. The extractor and comparison API/worker read
# Priority: process environment, key saved through the UI, then the root .env.
# The UI saves the key under data/secrets/jev.json (ignored by Git).
# Never use NEXT_PUBLIC_ for credentials.
TYPESAFE_API_KEY=

# The remaining variables must be exported in the process environment.
# They are NOT loaded automatically from the root .env.
# Development rewrite target; npm run dev also starts a local API on port 8787.
# BACKEND_URL=http://127.0.0.1:8787
# Python executable used by src/web/scripts/dev.mjs (absolute path recommended).
# PYTHON=C:\path\to\.venv\Scripts\python.exe
# PLAYWRIGHT_BROWSERS_PATH=E:\playwright-browsers

# Optional PostgreSQL connection. Without it local development uses SQLite.
# On Linux the service also checks /etc/scraper/database.env.
# SCRAPER_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/DATABASE

# Tests only: use a separate credential and a DISPOSABLE database.
# Do not point SCRAPER_TEST_DSN at production: its tests truncate tables.
# TYPESAFE_TEST_API_KEY=
# SCRAPER_TEST_DSN=postgresql://USER:PASSWORD@127.0.0.1:5433/DISPOSABLE_DATABASE
